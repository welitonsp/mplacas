{
  "name": "mplacas-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/render-csp.mjs",
    "preview": "vite preview",
    "type-check": "tsc -b --force",
    "check-bundle-budget": "node scripts/check-bundle-budget.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "capturar": "playwright test",
    "lint": "eslint src"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/eslint-parser": "^8.1.2",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  },
  "overrides": {
    "undici": "7.30.1",
    "jsdom": {
      "undici": "8.12.3"
    }
  }
