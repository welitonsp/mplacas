{
  "name": "mplacas-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/render-csp.mjs",
    "preview": "vite preview",
