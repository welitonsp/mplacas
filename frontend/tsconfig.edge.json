{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.edge.tsbuildinfo",
    "target": "ES2022",
    /* Cloudflare Workers expõe as APIs web padrão (fetch, Request, Headers,
       Response, URL, AbortController); a lib DOM as descreve sem trazer
       @cloudflare/workers-types como dependência nova. Sem tipos de Node. */
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["edge", "functions"]
}
