# Standalone image for the automated cost-audit guardrail (mplacas-cost-audit
# Cloud Run Job). Deliberately separate from the main application Dockerfile:
# it ships only infra/gcp/audit-costs.sh + infra/gcp/lib.sh and the Google
# Cloud SDK, never application source or secrets.
FROM gcr.io/google.com/cloudsdktool/google-cloud-cli:slim@sha256:70f3244ccf80a83c23805b5ff9f0b1a88d57b3fd07831d57a311e70625b289e9

ENV MPLACAS_CONFIG_FROM_ENV=1
ENV MPLACAS_AUDIT_SKIP_BILLING=1

# repo_root()/config_file() in lib.sh derive paths from the script's own
# location two directories up, so the infra/gcp/ layout must be preserved
# relative to WORKDIR.
WORKDIR /app

RUN groupadd --system mplacas && useradd --system --gid mplacas mplacas

COPY infra/gcp/audit-costs.sh infra/gcp/lib.sh ./infra/gcp/
RUN chmod +x ./infra/gcp/audit-costs.sh \
    && chown -R mplacas:mplacas /app

USER mplacas

ENTRYPOINT ["bash", "infra/gcp/audit-costs.sh"]
