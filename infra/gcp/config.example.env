# Copy to infra/gcp/config.env in Google Cloud Shell.
# Never commit config.env or real secret values.
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_SERVICE_NAME=mplacas-api
GCP_MIGRATION_JOB_NAME=mplacas-migrate
GCP_RUNTIME_SERVICE_ACCOUNT=mplacas-runtime
GCP_SCHEDULER_SERVICE_ACCOUNT=mplacas-scheduler
GCP_OPERATIONAL_JOB_PREFIX=mplacas
# Required by operational alert policies. Comma-separated full resource names.
# Example: projects/PROJECT_ID/notificationChannels/1234567890
GCP_MONITORING_NOTIFICATION_CHANNELS=
GCP_MIN_INSTANCES=0
GCP_MAX_INSTANCES=1
GCP_CPU=1
GCP_MEMORY=512Mi
GCP_CONCURRENCY=20
GCP_REQUEST_TIMEOUT=60
MPLACAS_TIMEZONE=America/Sao_Paulo
# Database secrets — dois endpoints separados do Neon:
#
#   mplacas-database-url (pooled):
#     Usado pelo Cloud Run runtime. Hostname contém "-pooler".
#     Cadastrar com: bash infra/gcp/set-secrets.sh database-runtime
#
#   mplacas-migration-database-url (direto/não-pooled):
#     Usado pelo Cloud Run Job de migrações (alembic upgrade head).
#     DDL requer conexão direta — NÃO use o endpoint pooled aqui.
#     Cadastrar com: bash infra/gcp/set-secrets.sh database-migration
#
# Ambos os valores ficam no Secret Manager — nunca neste arquivo.
# Both postgres:// and postgresql:// prefixes are normalized automatically.
# Exact Cloudflare Pages URL for CORS — never use wildcard (*).
# Example: https://mplacas-frontend.pages.dev
MPLACAS_CORS_ALLOWED_ORIGINS=
MPLACAS_DASHBOARD_URL=https://mplacas-frontend.pages.dev/dashboard
# Optional — Telegram alert chat ID (not a credential, just an identifier).
# Only wired into the deploy when non-empty. The bot token and webhook
# secret live in Secret Manager (mplacas-telegram-bot-token,
# mplacas-telegram-webhook-secret) and are included automatically in
# deploy-service.sh whenever those secrets exist in the project.
MPLACAS_TELEGRAM_ALERT_CHAT_ID=
# Required by operational jobs. These are identifiers/capacity values, not secrets.
MPLACAS_CLOUD_JOB_PLANT_NAME=
MPLACAS_CLOUD_JOB_EXPECTED_DAILY_PRODUCTION_KWH=
MPLACAS_CLOUD_JOB_EXPECTED_CYCLE_PRODUCTION_KWH=
# NEP account/password are stored in Secret Manager as mplacas-nep-account and
# mplacas-nep-password; configure them through set-secrets.sh.
